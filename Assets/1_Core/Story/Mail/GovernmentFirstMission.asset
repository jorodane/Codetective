  m_Script: {fileID: 11500000, guid: 575fde60b1403303a672c554f621dbc4, type: 3}
  m_Name: GovernmentFirstMission
  m_EditorClassIdentifier: ''
  message:
    id: government-first-mission
    mailbox: 1
    sender: 국가기록보안국 / 현장지원과
    subject: 첫 임무 배정 · 회사 지하실
    body: |
      Kernel 귀하.

      다음 상담 손님이 언급하는 회사 지하실의 야간 소음을 조사하십시오.

      진술에서 붉게 표시된 단서를 누르면 프로필에 기록되고 자료실 조사 권한이 열립니다. 확보한 정보를 바탕으로 Thread에게 정찰을 맡기십시오.

      이후 작전 지시는 이 메일함으로 전달됩니다.
    day: 1
    afterAppointmentId: '1:regular'
    minutesAfterAppointment: 5
    requiredFacts:
    - kernel_contact_received
    readFacts: []
    isReservationInquiry: 0
    requiresAcceptance: 1
    acceptLabel: 임무 수락
    acceptFacts:
    - kernel_assignment_accepted
    - mission01_started
    grantAuthorities:
    - clinic.basic
    condition:
      triggersOn: []
      triggersOff: []
      quests: []
    onRead:
      triggers: []
      quests: []
    onAccept:
      triggers:
      - id: intro.complete
        value: 1
      quests:
      - id: nsf.introduction
        stage: 10
        status: 1
