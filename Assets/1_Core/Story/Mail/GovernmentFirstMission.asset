  m_Script: {fileID: 11500000, guid: 575fde60b1403303a672c554f621dbc4, type: 3}
  m_Name: GovernmentFirstMission
  m_EditorClassIdentifier: ''
  message:
    id: government-first-mission
    mailbox: 1
    sender: 국가기록보안국 / 현장지원과
    subject: 첫 임무 배정 · Victor Hale 실종 사건
    body: "Kernel 귀하.\n\n현장 경찰이 [[GlobalMindFair|Global Mind Fair]]에서 [[VictorHale|Victor Hale]] [[VictorHaleDisappearance|실종 신고]]를 접수했습니다. 행사는 [[NsfPublicRelationsOffice|NSF Public Relations Office]]가 주최하고 있습니다.\n\nNSF 관련 사안으로 판단해 Kernel에게 수사 지휘를 요청합니다. 승인하면 신고자 [[Maggie|Margaret Maggie Sloan]]의 진술을 작전망으로 전달하겠습니다."
    day: 1
    afterConversation: kernel-onboarding
    afterAppointmentId: "1:regular"
    minutesAfterAppointment: 5
    requiredFacts:
    - kernel_contact_received
    readFacts: []
    isReservationInquiry: 0
    requiresAcceptance: 1
    acceptLabel: 승인
    pageOnAccept: kernel
    acceptFacts:
    - kernel_assignment_accepted
    - mission01_started
    grantAuthorities:
    - clinic.basic
    condition:
      triggersOn: []
      triggersOff: []
      quests: []
    onRead:
      triggers: []
      quests: []
    onAccept:
      triggers:
      - id: intro.complete
        value: 1
      quests:
      - id: nsf.introduction
        stage: 10
        status: 1
