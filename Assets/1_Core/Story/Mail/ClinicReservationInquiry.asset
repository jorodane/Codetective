  m_Name: ClinicReservationInquiry
  m_EditorClassIdentifier: ''
  message:
    id: clinic-reservation-followup
    mailbox: 0
    sender: 보호자 상담 예약자
    subject: 오전 상담 예약 문의
    body: '가족의 기억 재활 문제로 상담을 받고 싶습니다. 오전 11시부터 정오까지 방문할 수 있을까요?


      가능하다면 예약을 승인해 주세요. 확정된 시간에 방문하겠습니다.'
    day: 1
    requiredFacts:
    - kernel_assignment_accepted
    readFacts: []
    requiresAcceptance: 0
    acceptLabel: 확인
    acceptFacts: []
    grantAuthorities: []
    condition:
      triggersOn: []
      triggersOff: []
      quests: []
    onRead:
      triggers: []
      quests: []
    onAccept:
      triggers: []
      quests: []
    choices:
    - id: approve
      label: 예약 승인
      result: 1
      approvesReservation: 1
      condition:
        triggersOn: []
        triggersOff: []
        quests: []
      facts: []
      authorities: []
      effects:
        triggers:
        - id: clinic.request.care_followup.approved
          value: 1
        quests: []
    - id: decline
      label: 예약 거절
      result: 2
      approvesReservation: 0
      condition:
        triggersOn: []
        triggersOff: []
        quests: []
      facts: []
      authorities: []
      effects:
        triggers:
        - id: clinic.request.care_followup.declined
          value: 1
        quests: []
    isReservationInquiry: 1
    reservation:
      day: 2
      appointment:
        id: care_followup
        profileId: careVisitor
        patientName: 보호자 상담 손님
        title: 가족의 기억 재활 후속 상담
        description: 가족의 기억 재활 문제로 상담을 받고 싶습니다. 치료를 받는 가족을 일상에서 어떻게 도울 수 있을지 이야기하고 싶습니다.
        startMinute: 660
        endMinute: 720
        greeting: 예약을 승인해 주셔서 감사합니다.
        farewell: 오늘 말씀해 주셔서 감사합니다. 다음 상담에서 이어가겠습니다.
        dialogue:
        - profileId: careVisitor
          speaker: 보호자 상담 손님
          sentence: 치료가 계속될 수 있을지 걱정돼요. 가족에게 어떤 말을 해줘야 할까요?
          keyword: 치료 지속에 대한 걱정
          fact: care_followup_concern
          dataName: careFollowupConcern
          kind: 6
        condition:
          triggersOn: []
          triggersOff: []
          quests: []
        onArrival:
          triggers: []
          quests: []
        onCompleted:
          triggers:
          - id: clinic.followup.completed
            value: 1
          quests: []
        onTimeLimit:
          triggers:
          - id: clinic.followup.time_limit
            value: 1
          quests: []
