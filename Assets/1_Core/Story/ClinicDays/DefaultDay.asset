  m_Name: DefaultDay
  m_EditorClassIdentifier: ''
  plan:
    day: 0
    subtitle: 이어지는 이야기
    appointments:
    - id: morning
      profileId: client
      patientName: 오전 상담 손님
      title: 직장 스트레스
      description: 퇴근하고 나서 쉬는 시간이 어땠는지 돌아보고, 업무 생각이 계속 날 때 어떻게 해야 할지 이야기하고 싶습니다.
      startMinute: 600
      endMinute: 0
      greeting: 안녕하세요. 예약하고 왔습니다.
      farewell: 오늘 말씀해 주셔서 감사합니다. 다음 상담에서 이어가겠습니다.
      dialogue:
      - profileId: client
        speaker: 상담 손님
        sentence: 퇴근하고 잠깐 산책을 해봤어요. 걸을 때는 회사 생각이 좀 줄더라고요.
      - profileId: client
        speaker: 상담 손님
        sentence: 집에 오면 다시 해야 할 일이 떠오르긴 해요. 조금씩 익숙해지면 좋겠어요.
      condition:
        triggersOn: []
        triggersOff: []
        quests: []
      onArrival:
        triggers: []
        quests: []
      onCompleted:
        triggers:
        - id: clinic.completed.morning
          value: 1
        quests: []
      onTimeLimit:
        triggers:
        - id: clinic.time_limit.morning
          value: 1
        quests: []
    - id: career
      profileId: careerVisitor
      patientName: 취업 상담 손님
      title: 취업 지원과 직장 적응
      description: 새 직장에 적응하는 과정에서 겪은 일을 돌아보고, 앞으로의 진로를 함께 정리하고 싶습니다.
      startMinute: 780
      endMinute: 0
      greeting: 안녕하세요. 예약하고 왔습니다.
      farewell: 오늘 말씀해 주셔서 감사합니다. 다음 상담에서 이어가겠습니다.
      dialogue:
      - profileId: client
        speaker: 상담 손님
        sentence: 일자리를 찾는 게 쉽지 않았는데 NSF 커리어 센터에서 연락이 왔어요.
        keyword: NSF 커리어 센터
        fact: nsf_career_center
        dataName: careerCenterClue
        kind: 15
      - profileId: client
        speaker: 상담 손님
        sentence: 취업하고 나서도 센터에서 자주 연락을 줘요. 잘 적응하고 있는지 물어보더라고요.
        keyword: 취업 후 지속 상담
        fact: career_followup
        dataName: careerFollowupClue
        kind: 15
      condition:
        triggersOn: []
        triggersOff: []
        quests: []
      onArrival:
        triggers: []
        quests: []
      onCompleted:
        triggers:
        - id: clinic.completed.career
          value: 1
        quests: []
      onTimeLimit:
        triggers:
        - id: clinic.time_limit.career
          value: 1
        quests: []
    - id: regular
      profileId: regularVisitor
      patientName: 한정우
      title: 일상 스트레스 상담
      description: 잠들기 전에 떠오르는 생각과 일상에서 느낀 스트레스를 이야기하고 싶습니다.
      startMinute: 540
      endMinute: 600
      episodePoolId: regularTalk
      greeting: 안녕하세요. 지난번에 이어서 상담하러 왔습니다.
      farewell: 오늘은 여기까지 하시죠. 다음에 또 뵙겠습니다.
      dialogue: []
