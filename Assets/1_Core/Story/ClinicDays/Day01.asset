  m_Name: Day01
  m_EditorClassIdentifier: ''
  plan:
    day: 1
    subtitle: Kernel 프로젝트의 시작
    appointments:
    - id: morning
      profileId: client
      patientName: 오전 상담 손님
      title: 직장 스트레스
      description: 집에 돌아와서도 업무 생각이 떠올라 쉬기 어렵습니다. 퇴근 뒤 마음을 가라앉히는 방법을 이야기하고 싶습니다.
      startMinute: 600
      endMinute: 0
      greeting: 안녕하세요. 예약하고 왔습니다.
      farewell: 오늘 말씀해 주셔서 감사합니다. 다음 상담에서 이어가겠습니다.
      dialogue:
      - profileId: client
        speaker: 상담 손님
        sentence: 요즘은 퇴근하고 나서도 회사에서 해야 할 일이 자꾸 떠올라요.
      - profileId: client
        speaker: 상담 손님
        sentence: 집에 돌아오면 쉬고 싶은데, 어디서부터 마음을 놓아야 할지 모르겠어요.
      condition:
        triggersOn: []
        triggersOff: []
        quests: []
      onArrival:
        triggers: []
        quests: []
      onCompleted:
        triggers:
        - id: clinic.completed.morning
          value: 1
        quests: []
      onTimeLimit:
        triggers:
        - id: clinic.time_limit.morning
          value: 1
        quests: []
    - id: career
      profileId: careerVisitor
      patientName: 취업 상담 손님
      title: 취업 지원과 직장 적응
      description: 취업 지원을 받아 새 직장에 들어갔지만 적응이 쉽지 않습니다. 일하면서 느끼는 부담과 앞으로의 진로를 이야기하고 싶습니다.
      startMinute: 780
      endMinute: 900
      greeting: 안녕하세요. 예약하고 왔습니다.
      farewell: 오늘 말씀해 주셔서 감사합니다. 다음 상담에서 이어가겠습니다.
      dialogue:
      - profileId: client
        speaker: 상담 손님
        sentence: 일자리를 찾는 게 쉽지 않았는데 NSF 커리어 센터에서 연락이 왔어요.
        keyword: NSF 커리어 센터
        fact: nsf_career_center
        dataName: careerCenterClue
        kind: 15
      - profileId: client
        speaker: 상담 손님
        sentence: 취업하고 나서도 센터에서 자주 연락을 줘요. 잘 적응하고 있는지 물어보더라고요.
        keyword: 취업 후 지속 상담
        fact: career_followup
        dataName: careerFollowupClue
        kind: 15
      condition:
        triggersOn: []
        triggersOff: []
        quests: []
      onArrival:
        triggers: []
        quests: []
      onCompleted:
        triggers:
        - id: clinic.completed.career
          value: 1
        quests: []
      onTimeLimit:
        triggers:
        - id: clinic.time_limit.career
          value: 1
        quests: []
    - id: care
      profileId: careVisitor
      patientName: 보호자 상담 손님
      title: 가족의 기억 재활
      description: 기억 재활 치료를 받는 가족을 돌보고 있습니다. 치료가 계속될 수 있을지 걱정되고, 돌봄 부담도 상담하고 싶습니다.
      startMinute: 900
      endMinute: 1080
      greeting: 안녕하세요. 예약하고 왔습니다.
      farewell: 오늘 말씀해 주셔서 감사합니다. 다음 상담에서 이어가겠습니다.
      dialogue:
      - profileId: client
        speaker: 상담 손님
        sentence: 가족이 기억 재활 치료를 받고 있어요. 지원이 계속될지 걱정돼요.
        keyword: 기억 재활 치료
        fact: family_rehabilitation
        dataName: familyRehabilitationClue
        kind: 15
      - profileId: client
        speaker: 상담 손님
        sentence: 치료가 끊기면 제가 혼자 감당할 수 있을지 모르겠어요.
        keyword: ''
        fact: ''
        dataName: ''
        kind: 15
      condition:
        triggersOn: []
        triggersOff: []
        quests: []
      onArrival:
        triggers: []
        quests: []
      onCompleted:
        triggers:
        - id: clinic.completed.care
          value: 1
        quests: []
      onTimeLimit:
        triggers:
        - id: clinic.time_limit.care
          value: 1
        quests: []
    - id: regular
      profileId: regularVisitor
      patientName: 한정우
      title: 일상 스트레스 상담
      description: 요즘 잠들기 전에 이런저런 생각이 떠오릅니다. 일상에서 느끼는 스트레스와 수면에 관해 이야기하고 싶습니다.
      startMinute: 540
      endMinute: 600
      beforeAssignment: 1
      afterConversation: kernel-onboarding
      episodePoolId: regularTalk
      greeting: 안녕하세요. 아홉 시에 예약한 한정우입니다.
      farewell: 오늘은 여기까지 하시죠. 다음에 또 뵙겠습니다.
      dialogue: []
